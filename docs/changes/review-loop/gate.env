# review-loop 的閘：gate-pr.sh 與 /cc-review 讀這個檔（格式見 docs/changes/README.md）。
# PLUGIN_SYNC／PLUGIN_LOADS 不在這裡：它們比的是本機安裝狀態，不是這個 PR 的程式碼。
BASE=claude/review-loop-v04
GATE_1='claude plugin validate .claude-plugin/plugin.json --strict && claude plugin validate .claude-plugin/marketplace.json --strict'
GATE_2='python3 tools/check_docs.py .'
GATE_3='sh test/check-docs-resident.test.sh'
GATE_4='python3 tools/spec_merge.py check . && python3 test/spec_merge.test.py'
GATE_5='python3 test/test_skills.py'
GATE_6='node test/guard-bash.test.mjs'
GATE_7='[ ! -f test/dispatch_state.test.py ] || python3 test/dispatch_state.test.py'
GATE_8='[ ! -f test/gate-pr.test.sh ] || sh test/gate-pr.test.sh'
GATE_9='[ ! -f test/merge_pr.test.sh ] || sh test/merge_pr.test.sh'
GATE_TIMEOUT=600
